---
import Layout from "../layouts/Layout.astro";

// Update this block at the start of every month.
const month = {
  name: "October",
  region: "Sow now in the North Indian plains",
  vegetables: [
    "Spinach (palak)",
    "Fenugreek (methi)",
    "Coriander (dhaniya)",
    "Radish (mooli)",
    "Carrot",
    "Peas",
    "Garlic",
    "Mustard greens (sarson)",
  ],
  flowers: ["Marigold (genda)", "Calendula", "Petunia", "Sweet pea"],
};
---

<Layout title="FreshFynds – Gardening guides for Indian balconies and terraces">
  <section class="intro">
    <h1>Grow food and flowers in small spaces</h1>
    <p>
      Honest, India-specific guides for balcony and terrace gardeners: what to
      sow each season, which grow bags and tools are worth buying, and how to
      keep plants alive through our heat and monsoons.
    </p>
  </section>

  <section class="season" aria-labelledby="season-heading">
    <h2 id="season-heading" class="month">{month.name}</h2>
    <p class="region">{month.region}</p>
    <div class="lists">
      <div>
        <h3>Vegetables and greens</h3>
        <ul>{month.vegetables.map((v) => <li>{v}</li>)}</ul>
      </div>
      <div>
        <h3>Flowers</h3>
        <ul>{month.flowers.map((f) => <li>{f}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="coming">
    <h2>Guides being written now</h2>
    <ul>
      <li>Best grow bags for terrace vegetable gardens</li>
      <li>Potting mix for containers: what to buy and what to mix yourself</li>
      <li>A beginner's winter vegetable plan for a small balcony</li>
    </ul>
  </section>
</Layout>

<style>
  .intro h1 {
    font-size: clamp(2.1rem, 6vw, 3rem);
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }
  .intro p {
    max-width: 36rem;
    margin: 0;
  }

  .season {
    margin: 3rem 0;
    padding: 2rem 1.5rem 1.5rem;
    background: var(--leaf);
    color: var(--paper);
    border-radius: 6px;
  }
  .month {
    margin: 0;
    font-size: clamp(3.5rem, 15vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--marigold);
  }
  .region {
    margin: 0.75rem 0 1.5rem;
    font-size: 1.05rem;
  }
  .lists {
    display: grid;
    gap: 0.5rem 2rem;
  }
  @media (min-width: 560px) {
    .lists {
      grid-template-columns: 1fr 1fr;
    }
  }
  .season h3 {
    color: var(--paper);
    font-size: 1.1rem;
    margin: 0 0 0.25rem;
  }
  .season ul {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
  }

  .coming h2 {
    font-size: 1.5rem;
  }
  .coming li {
    margin-bottom: 0.35rem;
  }
</style>
