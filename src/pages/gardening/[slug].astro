---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection(
    "gardening",
    ({ data }) => import.meta.env.DEV || !data.draft
  );
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, publishDate, updatedDate, heroImage, heroAlt } = article.data;
const fmt = (d: Date) =>
  d.toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" });
---

<Layout title={`${title} – FreshFynds`} description={description}>
  <article>
    <p class="crumb"><a href="/gardening/">Gardening</a></p>
    <h1>{title}</h1>
    <p class="meta">
      Published <time datetime={publishDate.toISOString()}>{fmt(publishDate)}</time>
      {updatedDate && (
        <> · Updated <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></>
      )}
    </p>
    {heroImage && <img class="hero" src={heroImage} alt={heroAlt ?? ""} />}
    <p class="note">
      This guide may contain affiliate links. <a href="/affiliate-disclosure/">Here's how that works.</a>
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .crumb { margin: 0 0 0.5rem; font-family: var(--font-head); font-weight: 600; }
  h1 { font-size: clamp(2rem, 5.5vw, 2.75rem); margin: 0 0 0.75rem; letter-spacing: -0.02em; }
  .meta { color: var(--stone); font-size: 0.95rem; margin: 0 0 1.5rem; }
  .hero { border-radius: 6px; margin-bottom: 1rem; }
  .note {
    font-size: 0.9rem; color: var(--stone);
    border-left: 3px solid var(--marigold); padding-left: 0.75rem;
  }
  .prose :global(h2) { font-size: 1.6rem; margin: 2.5rem 0 0.75rem; }
  .prose :global(h3) { font-size: 1.25rem; margin: 2rem 0 0.5rem; }
  .prose :global(img) { border-radius: 6px; margin: 1rem 0; }
  .prose :global(li) { margin-bottom: 0.35rem; }
  .prose :global(blockquote) {
    margin: 1.5rem 0; padding: 0.75rem 1rem;
    background: var(--leaf-soft); border-radius: 6px;
  }
  .prose :global(table) { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--leaf-soft); padding: 0.5rem; text-align: left; }
</style>
