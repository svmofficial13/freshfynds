---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection(
    "gardening",
    ({ data }) => import.meta.env.DEV || !data.draft
  );
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, publishDate, updatedDate, heroImage, heroAlt } = article.data;
const fmt = (d: Date) =>
  d.toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" });
---

<Layout title={`${title} – FreshFynds`} description={description} image={heroImage}>
  <header class="not-prose">
    <a href="/gardening/" class="font-head text-sm font-semibold uppercase tracking-[0.14em] text-marigold no-underline hover:underline">
      ← Gardening
    </a>
    <h1 class="mt-3 text-[clamp(2.1rem,5.5vw,3rem)] font-extrabold leading-[1.08] tracking-tight">{title}</h1>
    <p class="mt-4 text-lg text-stone">{description}</p>
    <p class="mt-4 text-sm text-stone">
      Published <time datetime={publishDate.toISOString()}>{fmt(publishDate)}</time>
      {updatedDate && (
        <> · <strong class="font-semibold text-leaf">Updated <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></strong></>
      )}
    </p>
    {heroImage && <img class="mt-8 w-full rounded-2xl object-cover shadow-md" src={heroImage} alt={heroAlt ?? ""} />}
    <p class="mt-8 border-l-4 border-marigold pl-4 text-sm text-stone">
      This guide may contain affiliate links.
      <a href="/affiliate-disclosure/" class="text-leaf underline underline-offset-4">Here's how that works.</a>
    </p>
  </header>

  <Content />
</Layout>
