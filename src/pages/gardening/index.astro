---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const articles = (
  await getCollection("gardening", ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" });
---

<Layout
  title="Gardening guides – FreshFynds"
  description="Real-life gardening guides for Indian balconies and terraces: fruit plants, flowering plants, vegetables, pests and seasons."
>
  <h1>Gardening</h1>
  <p class="lead">
    Real problems from my two terraces in Punjab, and the step-by-step fixes
    that actually work in Indian weather. No viral hacks.
  </p>

  {articles.length === 0 ? (
    <p class="empty">The first guides are being written. Check back soon.</p>
  ) : (
    <ul class="list">
      {articles.map((a) => (
        <li>
          <a href={`/gardening/${a.id}/`}>
            {a.data.heroImage && (
              <img src={a.data.heroImage} alt={a.data.heroAlt ?? ""} loading="lazy" />
            )}
            <h2>{a.data.title}{a.data.draft && <span class="draft"> (draft)</span>}</h2>
          </a>
          <p>{a.data.description}</p>
          <time datetime={a.data.publishDate.toISOString()}>{fmt(a.data.publishDate)}</time>
        </li>
      ))}
    </ul>
  )}
</Layout>

<style>
  .lead { max-width: 36rem; }
  .empty { color: var(--stone); }
  .list { list-style: none; padding: 0; margin: 2.5rem 0 0; }
  .list li { padding: 1.5rem 0; border-top: 1px solid var(--leaf-soft); }
  .list a { text-decoration: none; }
  .list img { border-radius: 6px; margin-bottom: 0.75rem; }
  .list h2 { font-size: 1.4rem; margin: 0 0 0.4rem; }
  .list p { margin: 0 0 0.4rem; }
  .list time { color: var(--stone); font-size: 0.9rem; }
  .draft { color: var(--marigold); font-size: 0.9rem; }
</style>
